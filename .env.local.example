# OpenAI Configuration
# Go to https://platform.openai.com/api-keys
# Key should start with 'sk-...'
VITE_OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: Model Selection (default: whisper-1)
VITE_OPENAI_MODEL=whisper-1

# Supabase Configuration
# NOTE: Supabase is not required for local development in this version.
# The application uses localStorage for data persistence.
# For production, implementing a real backend (like Supabase) is recommended.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=